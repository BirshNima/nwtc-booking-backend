# ============================================================================
# Northwest Town Car Service — analytics env  (copy to .env, never commit)
# ============================================================================

# ---- GA4 (client) — this one is public, it ships in the page ---------------
GA4_MEASUREMENT_ID=G-XXXXXXXXXX

# ---- GA4 Measurement Protocol (server-side events, e.g. deposit_paid) -----
GA4_API_SECRET=xxx            # Admin -> Data Streams -> Measurement Protocol API secrets

# ---- Google Ads offline conversion import (step 10; not needed for GA4) ---
GOOGLE_ADS_CUSTOMER_ID=123-456-7890
GOOGLE_ADS_DEVELOPER_TOKEN=xxx
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
# OAuth for the Ads API (or just export CSV from the UI and skip these):
GOOGLE_ADS_CLIENT_ID=xxx
GOOGLE_ADS_CLIENT_SECRET=xxx
GOOGLE_ADS_REFRESH_TOKEN=xxx
# Conversion action names must match the two you create in Ads:
ADS_ACTION_DEPOSIT=Deposit paid
ADS_ACTION_FARE=Fare collected

# ---- Microsoft Ads (optional) -------------------------------------------
MICROSOFT_ADS_CUSTOMER_ID=
MICROSOFT_ADS_DEVELOPER_TOKEN=

# ---- Shared ------------------------------------------------------------
AIRTABLE_TOKEN=pat_xxx
AIRTABLE_BASE_ID=app_xxx
