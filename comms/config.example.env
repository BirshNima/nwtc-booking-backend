# ============================================================================
# Northwest Town Car Service — comms env  (copy to .env, never commit)
# ============================================================================

# ---- Twilio (SMS) ----------------------------------------------------------
TWILIO_ACCOUNT_SID=AC_xxx
TWILIO_AUTH_TOKEN=xxx
# Prefer a Messaging Service (handles the 10DLC campaign + number pool):
TWILIO_MESSAGING_SERVICE_SID=MG_xxx
# ...or a single number if you're not using a Messaging Service:
TWILIO_FROM_NUMBER=+1206XXXXXXX
# A2P 10DLC brand + campaign MUST be registered and approved before these
# deliver reliably — start that the day you buy the number (1–3 weeks).

# ---- Email (Postmark shape; swap send.js sendEmail() for SES/Resend) ------
EMAIL_API_URL=https://api.postmarkapp.com/email
EMAIL_API_TOKEN=xxx
EMAIL_FROM=book@northwesttowncarservice.com
# SPF + DKIM on northwesttowncarservice.com before first send.

# ---- Behaviour -----------------------------------------------------------
# 1 = render + log but do not actually send (safe for staging)
COMMS_DRY_RUN=0

# ---- Shared with booking-payment ---------------------------------------
AIRTABLE_TOKEN=pat_xxx
AIRTABLE_BASE_ID=app_xxx
DISPATCH_WEBHOOK_URL=
# Tables this layer uses on top of the CRM base: Messages
# (Dedupe Key, Reference, Template, Channel, To, Status, Provider Id, Error, Sent At)
# Lead fields it writes: Customer Replied, Needs Reply, Followup Steps Sent
# Customer fields it writes: SMS Opt-out
