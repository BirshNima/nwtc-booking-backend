# ============================================================================
# Northwest Town Car Service — booking/payment env  (copy to .env, never commit)
# ============================================================================

# ---- Stripe -------------------------------------------------------------------
# Dashboard -> Developers -> API keys. Use the TEST keys until go-live.
STRIPE_SECRET_KEY=sk_test_xxx
# Dashboard -> Developers -> Webhooks -> add endpoint (.../stripe-webhook),
# subscribe to: checkout.session.completed, checkout.session.expired,
#               payment_intent.payment_failed, charge.refunded
STRIPE_WEBHOOK_SECRET=whsec_xxx

# ---- Where the site lives (used to build Checkout return URLs) ---------------
SITE_ORIGIN=https://northwesttowncarservice.com
# Checkout link lifetime in minutes (30 .. 1439). Default 1440 is clamped to 1439.
CHECKOUT_EXPIRES_MINUTES=1440

# ---- Dispatch-only auth for POST /deposit-link ------------------------------
# Any long random string. The person/automation that confirms rides sends it as
#   Authorization: Bearer <token>
DISPATCH_API_TOKEN=change-me-to-a-64-char-random-string

# ---- Dispatch alerts --------------------------------------------------------
# Simplest: a Make/Zapier "catch webhook", or a Slack incoming webhook. The
# server POSTs { subject, text, to }. If unset, alerts are only console.warn'd.
DISPATCH_WEBHOOK_URL=
DISPATCH_EMAIL=booking@northwesttowncarservice.com

# ---- CRM (Airtable) --------------------------------------------------------
# Personal access token with data.records:read + data.records:write on the base.
AIRTABLE_TOKEN=pat_xxx
AIRTABLE_BASE_ID=app_xxx
# Tables used: Customers, Leads, Quotes, Bookings, Corporate Accounts,
#              Payments, Activity Log, Webhook Events

# ---- Pricing --------------------------------------------------------------
# Allowed +/- difference (dollars) between the client price and the server
# re-price before the lead is flagged as a mismatch.
PRICE_TOLERANCE=0.01
